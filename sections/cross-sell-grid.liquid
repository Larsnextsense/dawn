{% schema %}
{
  "name": "Cross-Sell Grid",
  "settings": [
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Maak jouw bar compleet"
    },
    {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
    },
    {
        "type": "range",
        "id": "products_to_show",
        "label": "Products to show",
        "min": 2,
        "max": 4,
        "default": 3
    }
  ],
  "presets": [
    {
      "name": "Cross-Sell Grid"
    }
  ]
}
{% endschema %}

<div class="cross-sell-section page-width">
    {% if section.settings.heading != blank %}
    <h2 class="cross-sell__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="cross-sell__grid grid grid--3-col-desktop grid--1-col-mobile">
        {% assign collection = collections[section.settings.collection] %}
        {% if collection != blank %}
            {% for product in collection.products limit: section.settings.products_to_show %}
                <div class="cross-sell__item grid__item">
                    {% render 'card-product', 
                        card_product: product, 
                        media_aspect_ratio: 'square', 
                        show_secondary_image: false, 
                        show_vendor: false, 
                        show_rating: false 
                    %}
                </div>
            {% endfor %}
        {% else %}
            {% for i in (1..3) %}
                 <div class="cross-sell__item grid__item">
                    <div class="card-wrapper">
                        <div class="card card--card card--text-only color-scheme-1">
                            <div class="card__inner">
                                <div class="card__content">
                                    <h3 class="card__heading">Example Product {{ i }}</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                 </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<style>
.cross-sell-section {
    padding: 60px 0;
}
.cross-sell__heading {
    text-align: center;
    font-family: var(--font-heading-family);
    color: #1A4F8B;
    margin-bottom: 40px;
    font-size: 28px;
    text-transform: uppercase;
}
.cross-sell__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
}
.cross-sell__item {
    flex: 1;
    min-width: 250px;
}
</style>
