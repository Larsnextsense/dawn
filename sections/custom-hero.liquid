<div class="custom-hero">
  <div class="custom-hero__bg">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          class: 'custom-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1600,2000',
          sizes: '100vw'
      }}
    {%- else -%}
      <div class="placeholder-background">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="custom-hero__overlay"></div>
  </div>

  <div class="custom-hero__content page-width">
    {%- if section.settings.badge_text != blank -%}
      <div class="custom-hero__badge">
        <span class="custom-hero__badge-dot"></span>
        {{ section.settings.badge_text }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="custom-hero__title">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <div class="custom-hero__subtitle rte">
        {{ section.settings.subtitle }}
      </div>
    {%- endif -%}

    {%- if section.settings.trust_line != blank -%}
      <p class="custom-hero__trust-line">{{ section.settings.trust_line }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="custom-hero__actions">
        <a class="custom-hero__cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>

        {%- if section.settings.show_scroll_hint and section.settings.scroll_hint_text != blank -%}
          <a class="custom-hero__scroll-hint" href="{{ section.settings.scroll_hint_link | default: '#home-pricing' }}">
            {{ section.settings.scroll_hint_text }}
            <svg class="custom-hero__scroll-hint-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="custom-hero__stats page-width">
    <div class="custom-hero__stats-inner">
      {%- for block in section.blocks -%}
        <div class="custom-hero__stat-item">
          <div class="custom-hero__stat-value">{{ block.settings.value }}</div>
          <div class="custom-hero__stat-label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "#1 Mobiele Bar Service van Nederland"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "Jouw feestje,<br><span style='color: #F59E0B;'>koud geleverd.</span>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subheading",
      "default": "<p>Premium mobiele bar service voor elk moment. Van intieme borrels tot grote feesten — wij regelen alles. Jij geniet.</p>"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line (onder de subtitel)",
      "default": "Gratis bezorging in vrijwel heel NL · Geen verborgen kosten · Bestel makkelijk online"
    },
    {
      "type": "header",
      "content": "Knoppen"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knoptekst",
      "default": "Bekijk pakketten"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Knop link",
      "info": "Bijv. #home-pricing om naar de pakketten te scrollen"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Toon tweede link (Zo werkt het)",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_hint_text",
      "label": "Tekst tweede link",
      "default": "Zo werkt het"
    },
    {
      "type": "url",
      "id": "scroll_hint_link",
      "label": "Link tweede link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "€17,50"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "per persoon vanaf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "€17,50",
            "label": "per persoon vanaf"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "500+",
            "label": "tevreden klanten"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Gratis",
            "label": "bezorging vrijwel heel NL"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "24u",
            "label": "snelle levering"
          }
        }
      ]
    }
  ]
}
{% endschema %}
