<section class="custom-pricing" id="home-pricing" aria-label="Onze pakketten">
  <div class="page-width">
    <div class="custom-pricing__header">
    {%- if section.settings.pretitle != blank -%}
      <div class="custom-pricing__pretitle">{{ section.settings.pretitle }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="custom-pricing__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="custom-pricing__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.trust_line != blank -%}
      <p class="custom-pricing__trust-line">{{ section.settings.trust_line }}</p>
    {%- endif -%}
  </div>

    {%- assign package_blocks = section.blocks | where: 'type', 'package' -%}
    {%- assign assurance_blocks = section.blocks | where: 'type', 'assurance' -%}

    <div class="custom-pricing__grid">
    {%- for block in package_blocks -%}
      <div class="custom-pricing__card {% if block.settings.is_popular %}custom-pricing__card--popular{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.is_popular -%}
          <div class="custom-pricing__popular-badge">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
            {{ block.settings.popular_text }}
          </div>
        {%- endif -%}

        {%- if block.settings.is_popular and block.settings.popular_subtext != blank -%}
          <p class="custom-pricing__popular-note">{{ block.settings.popular_subtext }}</p>
        {%- endif -%}

        <div class="custom-pricing__card-header">
          <h3 class="custom-pricing__card-title">{{ block.settings.title }}</h3>
          <p class="custom-pricing__card-desc">{{ block.settings.description }}</p>
          {%- if block.settings.short_description != blank -%}
            <p class="custom-pricing__card-short-desc">{{ block.settings.short_description }}</p>
          {%- endif -%}
          {%- if block.settings.good_to_know != blank -%}
            <p class="custom-pricing__card-note">{{ block.settings.good_to_know }}</p>
          {%- endif -%}
        </div>

        <div class="custom-pricing__card-price-wrapper">
          <span class="custom-pricing__card-currency">€</span>
          <span class="custom-pricing__card-price">{{ block.settings.price }}</span>
        </div>
        <div class="custom-pricing__card-price-desc">
          <span>per persoon</span>
          <span class="custom-pricing__card-min">{{ block.settings.min_persons }}</span>
        </div>

        <ul class="custom-pricing__features">
          {%- if block.settings.feature_1 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_1 }}
            </li>
          {%- endif -%}
          {%- if block.settings.feature_2 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_2 }}
            </li>
          {%- endif -%}
          {%- if block.settings.feature_3 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_3 }}
            </li>
          {%- endif -%}
          {%- if block.settings.feature_4 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_4 }}
            </li>
          {%- endif -%}
          {%- if block.settings.feature_5 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_5 }}
            </li>
          {%- endif -%}
          {%- if block.settings.feature_6 != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              {{ block.settings.feature_6 }}
            </li>
          {%- endif -%}
        </ul>

        <a href="{{ block.settings.button_link | default: '#' }}" class="custom-pricing__btn">
          {{ block.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {%- endfor -%}
    </div>

    {%- if section.settings.doubt_line != blank -%}
      <p class="custom-pricing__doubt">{{ section.settings.doubt_line }}</p>
    {%- endif -%}

    {%- if assurance_blocks.size > 0 -%}
      <div class="custom-pricing__assurances">
        {%- if section.settings.assurances_heading != blank -%}
          <h3 class="custom-pricing__assurances-title">{{ section.settings.assurances_heading }}</h3>
        {%- endif -%}

        <ul class="custom-pricing__assurances-list">
          {%- for block in assurance_blocks -%}
            <li class="custom-pricing__assurance" {{ block.shopify_attributes }}>
              <span class="custom-pricing__assurance-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span class="custom-pricing__assurance-body">
                <span class="custom-pricing__assurance-title">{{ block.settings.title }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="custom-pricing__assurance-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.assurances_note != blank -%}
          <p class="custom-pricing__assurances-note">{{ section.settings.assurances_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Pricing",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "pretitle",
      "label": "Pretitle",
      "default": "ONZE PAKKETTEN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Kies jouw perfecte pakket"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Van intieme borrel tot groots feest. Wij hebben voor elk moment de perfecte oplossing."
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line (onder subtitle)",
      "default": "Gratis bezorging in vrijwel heel NL · Afwaskosten inbegrepen · Geen borg"
    },
    {
      "type": "header",
      "content": "Onder de pakketten"
    },
    {
      "type": "text",
      "id": "doubt_line",
      "label": "Twijfelregel (direct onder de pakketten)",
      "default": "Zijn er nog twijfels? Voor de meeste mensen is Goed geregeld perfect."
    },
    {
      "type": "text",
      "id": "assurances_heading",
      "label": "Titel boven de optelijst",
      "default": "Bij elk pakket inbegrepen"
    },
    {
      "type": "text",
      "id": "assurances_note",
      "label": "Notitie onder de optelijst",
      "default": "Twijfel je of jouw locatie binnen ons bezorggebied valt? Bel even: 0341 700 260."
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as Popular",
          "default": false
        },
        {
          "type": "text",
          "id": "popular_text",
          "label": "Popular Badge Text",
          "default": "Populair"
        },
        {
          "type": "text",
          "id": "popular_subtext",
          "label": "Extra tekst onder de Populair-badge",
          "default": "Voor de meeste feesten is dit de beste keuze"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Basis"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Slogan",
          "default": "Perfect voor kleine feestjes"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "Korte omschrijving"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "17,50"
        },
        {
          "type": "text",
          "id": "min_persons",
          "label": "Minimum personen",
          "default": "Minimaal 10 personen"
        },
        {
          "type": "text",
          "id": "good_to_know",
          "label": "Goed om te weten"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Premium pils van tap"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Professionele tapinstallatie"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": "Glazen inbegrepen"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4",
          "default": "Gratis bezorgd in vrijwel heel NL"
        },
        {
          "type": "text",
          "id": "feature_5",
          "label": "Feature 5",
          "default": "Koelunit Inbegrepen"
        },
        {
          "type": "text",
          "id": "feature_6",
          "label": "Feature 6"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Dit pakket kiezen"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "assurance",
      "name": "Inbegrepen-punt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Gratis bezorgd en opgehaald"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Toelichting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Pricing",
      "blocks": [
        {
          "type": "package",
          "settings": {
            "title": "Basis",
            "description": "Perfect voor kleine feestjes",
            "price": "17,50",
            "min_persons": "Minimaal 10 personen",
            "is_popular": false
          }
        },
        {
          "type": "package",
          "settings": {
            "title": "Speciaalbier",
            "description": "Voor de echte bierliefhebber",
            "price": "22,50",
            "min_persons": "Minimaal 15 personen",
            "is_popular": true
          }
        },
        {
          "type": "package",
          "settings": {
            "title": "Wijn & Bubbels",
            "description": "Elegant & feestelijk",
            "price": "24,50",
            "min_persons": "Minimaal 20 personen",
            "is_popular": false
          }
        },
        {
          "type": "package",
          "settings": {
            "title": "All-In",
            "description": "Alles voor het ultieme feest",
            "price": "32,50",
            "min_persons": "Minimaal 25 personen",
            "is_popular": false
          }
        },
        {
          "type": "assurance",
          "settings": {
            "title": "Gratis bezorgd en opgehaald",
            "text": "In vrijwel heel Nederland. 1 werkdag vóór je feest gebracht, 1 werkdag erna opgehaald."
          }
        },
        {
          "type": "assurance",
          "settings": {
            "title": "Vuile glazen? Geen probleem",
            "text": "Alles mag ongewassen terug in de krat. Wij nemen het gewoon mee."
          }
        },
        {
          "type": "assurance",
          "settings": {
            "title": "Geen borg",
            "text": "Je betaalt vooraf alleen je pakket. Geen borgsom, geen verrassingen achteraf."
          }
        },
        {
          "type": "assurance",
          "settings": {
            "title": "Drank over? Geld terug",
            "text": "Ongeopende flessen en kratten nemen wij retour en krijg je terugbetaald."
          }
        },
        {
          "type": "assurance",
          "settings": {
            "title": "De afwas doen wij",
            "text": "Afwaskosten zitten bij de prijs in. Jij hoeft geen glas aan te raken."
          }
        }
      ]
    }
  ]
}
{% endschema %}
