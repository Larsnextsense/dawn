{%- comment -%}
  404 — een doodlopende pagina is een verloren bezoeker. In plaats van alleen
  "niet gevonden" bieden we de routes aan waar mensen meestal naartoe willen.
{%- endcomment -%}

<section class="error-404">
  <div class="page-hero">
    <div class="page-width">
      {%- if section.settings.pretitle != blank -%}
        <p class="page-hero__pretitle">{{ section.settings.pretitle }}</p>
      {%- endif -%}
      <h1 class="page-hero__title">
        {{ section.settings.title | default: 'Deze pagina bestaat niet meer' }}
      </h1>
      {%- if section.settings.subtitle != blank -%}
        <div class="page-hero__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="error-404__body">
    <div class="page-width">
      {%- assign links = section.blocks | where: 'type', 'link' -%}
      {%- if links.size > 0 -%}
        <ul class="error-404__links">
          {%- for block in links -%}
            <li {{ block.shopify_attributes }}>
              <a class="error-404__link" href="{{ block.settings.link | default: '/' }}">
                <span class="error-404__link-text">
                  <span class="error-404__link-title">{{ block.settings.title }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="error-404__link-desc">{{ block.settings.text }}</span>
                  {%- endif -%}
                </span>
                <span class="error-404__link-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.help_text != blank -%}
        <p class="error-404__help">
          {{ section.settings.help_text }}
          {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "pretitle",
      "label": "Pretitle",
      "default": "404"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Deze pagina bestaat niet meer"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Ondertitel",
      "default": "<p>Misschien is de link verouderd of is er een typefout geslopen. Hieronder vind je de weg terug.</p>"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Hulpregel onderaan",
      "default": "Kom je er niet uit? Bel ons even:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefoonnummer",
      "default": "0341 700 260"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Bekijk pakketten"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Toelichting"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
