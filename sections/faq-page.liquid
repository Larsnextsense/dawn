{%- comment -%} Toon alleen op de FAQ-pagina (handle faq of veelgestelde-vragen) {%- endcomment -%}
{%- if page.handle == 'faq' or page.handle == 'veelgestelde-vragen' -%}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

<section class="faq-page">
  <div class="page-hero">
    <div class="page-width">
      {%- if section.settings.pretitle != blank -%}
        <p class="page-hero__pretitle">{{ section.settings.pretitle }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="page-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <div class="page-hero__subtitle rte">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="faq-page__body">
  <div class="page-width faq-page__container">
    <div class="faq-page__content">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="faq-page__group-title" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- endif -%}
        {%- elsif block.type == 'item' -%}
          <div class="faq-page__item accordion" {{ block.shopify_attributes }}>
            <details id="Details-{{ block.id }}-{{ section.id }}">
              <summary id="Summary-{{ block.id }}-{{ section.id }}">
                <span class="summary__title">
                  <span class="faq-page__question">{{ block.settings.question | default: 'Vraag' }}</span>
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                class="accordion__content faq-page__answer rte"
                id="Collapsible-{{ block.id }}-{{ section.id }}"
                role="region"
                aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
              >
                {{ block.settings.answer }}
              </div>
            </details>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ (pagina)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "pretitle",
      "label": "Pretitle",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Veelgestelde vragen"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Ondertitel",
      "default": "<p>Alles wat je wilt weten over onze service, pakketten en bezorging.</p>"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Sectiekop",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Kop",
          "default": "Bestellen"
        }
      ]
    },
    {
      "type": "item",
      "name": "Vraag & antwoord",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Vraag"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwoord"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ (pagina)"
    }
  ]
}
{% endschema %}
